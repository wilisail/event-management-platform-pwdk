{
  "name": "temuevent-feature-1",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "concurrently --kill-others -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3000",
    "dev:api": "node --import tsx --watch server/integrated.ts",
    "build": "next build",
    "start:web": "next start --hostname 127.0.0.1 --port 3000",
    "start:api": "node --import tsx server/integrated.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate && npm --prefix feature-2 run db:generate",
    "db:validate": "prisma validate",
    "db:seed": "prisma db seed",
    "db:check": "node --import ./server/rizky-env.mjs --import tsx server/check-database.ts",
    "predev": "npm run db:generate",
    "pretypecheck": "npm run db:generate",
    "prebuild": "npm run db:generate",
    "predev:api": "npm run db:generate",
    "prestart:api": "npm run db:generate",
    "db:shared": "prisma db execute --config prisma.shared.config.ts",
    "test:integration": "node --import tsx --test tests/integration-*.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/server": "^1.9.2",
    "@vercel/analytics": "1.6.1",
    "@vercel/functions": "3.10.6",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "dotenv": "18.0.8",
    "express": "^5.3.0",
    "lucide-react": "^1.16.0",
    "multer": "^2.5.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24",
    "@types/pg": "8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.0",
    "postcss": "^8.5",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "5.7.3"
  }
}
