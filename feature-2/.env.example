# Real account pages require the private backend settings below; /preview uses fixtures.
F2_API_PORT=4002
F2_API_HOST=127.0.0.1
# Next.js forwards relative /api requests here. The older F2_DEMO_API_ORIGIN remains a fallback.
F2_API_ORIGIN=http://127.0.0.1:4002
F2_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_F1_ORIGIN=http://localhost:3000

# DATABASE_URL enables real registration and protected database reads.
# Copy the connection details from the project's Connect panel; keep real values in .env.
# DATABASE_URL=postgresql://APP_USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full
# DIRECT_URL=postgresql://MIGRATION_USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full
# The included ../database/certs/prod-ca-2021.crt is trusted by default.
# Override only when using a different verified CA file:
# DATABASE_CA_CERT_PATH=/absolute/path/to/server-ca.pem
F2_DATABASE_CHECK_ENABLED=false

# Working coupon value from the prototype; not prescribed by the PRD.
# Changes apply to future referral signups; previously issued coupons retain their value.
REFERRAL_COUPON_IDR=25000

# DATABASE_URL plus a private 32-byte key enables login/refresh/logout.
# Generate once with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep the output in your backend .env or hosting secrets, never in Git or NEXT_PUBLIC_*.
# AUTH_JWT_SECRET=YOUR_64_HEXADECIMAL_CHARACTERS
# NODE_ENV=production forces Secure, __Host-prefixed cookies. Use HTTPS/same-origin /api.
# Set F2_ALLOWED_ORIGINS to the exact HTTPS web origin when deploying.

# Profile-photo storage: backend only; keep both values out of NEXT_PUBLIC_* and Git.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=YOUR_BACKEND_SECRET_KEY
# A legacy service_role key also works here; never use an anon/publishable key.
F2_PROFILE_BUCKET=profile-pictures
# After configuration, run npm run storage:setup once to create/verify the private bucket.

