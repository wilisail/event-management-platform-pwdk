# The fixture preview runs without database credentials. Optional database settings are below.
F2_API_PORT=4002
F2_API_HOST=127.0.0.1
F2_DEMO_API_ORIGIN=http://127.0.0.1:4002
F2_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_F1_ORIGIN=http://localhost:3000

# Optional database milestone. Demo screens still work without these settings.
# Copy the connection details from the project's Connect panel; keep real values in .env.
# DATABASE_URL=postgresql://APP_USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full
# DIRECT_URL=postgresql://MIGRATION_USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full
# DATABASE_CA_CERT_PATH=/absolute/path/to/server-ca.pem
F2_DATABASE_CHECK_ENABLED=false
