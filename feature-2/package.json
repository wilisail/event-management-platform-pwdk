{
  "name": "temuevent-feature-2-preview",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone feature 2 account/rewards prototype, demo API and initial database connection",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3001",
    "dev:api": "node --import tsx --watch server/index.ts",
    "build": "next build",
    "start:web": "next start --hostname 127.0.0.1 --port 3001",
    "start:api": "node --import tsx server/index.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:seed": "prisma db seed",
    "db:check": "node --import tsx server/check-database.ts",
    "predev": "npm run db:generate",
    "pretypecheck": "npm run db:generate",
    "prebuild": "npm run db:generate",
    "predev:api": "npm run db:generate",
    "prestart:api": "npm run db:generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.0",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.7.3"
  }
}
