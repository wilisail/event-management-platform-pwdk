{
  "name": "temuevent-feature-2-preview",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone feature 2 preview with database-backed registration and sessions",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3001",
    "dev:api": "node --import tsx --watch server/index.ts",
    "build": "next build",
    "start:web": "next start --hostname 127.0.0.1 --port 3001",
    "start:api": "node --import tsx server/index.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:seed": "prisma db seed",
    "db:check": "node --import tsx server/check-database.ts",
    "predev": "npm run db:generate",
    "pretypecheck": "npm run db:generate",
    "prebuild": "npm run db:generate",
    "predev:api": "npm run db:generate",
    "prestart:api": "npm run db:generate",
    "db:verify:registration": "node --import tsx scripts/verify-registration.ts",
    "predb:verify:registration": "npm run db:generate",
    "db:verify:sessions": "node --import tsx scripts/verify-sessions.ts",
    "predb:verify:sessions": "npm run db:generate",
    "db:verify:authorization": "node --import tsx scripts/verify-authorization.ts",
    "predb:verify:authorization": "npm run db:generate",
    "db:verify:rewards-schema": "node --import tsx scripts/verify-reward-schema.ts",
    "predb:verify:rewards-schema": "npm run db:generate",
    "db:verify:referrals": "node --import tsx scripts/verify-referral-registration.ts",
    "predb:verify:referrals": "npm run db:generate",
    "db:verify:wallet": "node --import tsx scripts/verify-wallet.ts",
    "predb:verify:wallet": "npm run db:generate",
    "db:verify:reward-operations": "node --import tsx scripts/verify-reward-operations.ts",
    "predb:verify:reward-operations": "npm run db:generate",
    "db:verify:reward-races": "node --import tsx scripts/verify-reward-races.ts",
    "predb:verify:reward-races": "npm run db:generate",
    "storage:setup": "node --import tsx scripts/setup-profile-storage.ts",
    "db:verify:profiles": "node --import tsx scripts/verify-profiles.ts",
    "predb:verify:profiles": "npm run db:generate",
    "db:verify:profile-storage": "node --import tsx scripts/verify-profiles.ts --hosted-storage",
    "predb:verify:profile-storage": "npm run db:generate",
    "db:verify:password-change": "node --import tsx scripts/verify-password-change.ts",
    "predb:verify:password-change": "npm run db:generate",
    "db:verify:password-races": "node --import tsx scripts/verify-password-races.ts",
    "predb:verify:password-races": "npm run db:generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/supabase-js": "2.118.0",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-rate-limit": "8.7.2",
    "jose": "6.2.14",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.2.0",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.7.3"
  }
}
