generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
  schemas  = ["temuevent"]
}

enum UserRole {
  CUSTOMER
  ORGANIZER

  @@schema("temuevent")
}

// Shared starter. Authentication/rewards and feature business rules are implemented separately.
model User {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String   @unique
  name              String
  role              UserRole @default(CUSTOMER)
  passwordHash      String?  @map("password_hash")
  referralCode      String   @unique @map("referral_code") @db.VarChar(16)
  profilePictureKey String?  @map("profile_picture_key")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  events    Event[]
  purchases Purchase[]
  sessions  AuthSession[]
  referralsGiven Referral[] @relation("ReferralsGiven")
  referralUsed   Referral?  @relation("ReferralUsed")
  pointGrants    PointGrant[]
  rewardCoupons  RewardCoupon[]
  rewardRedemptions RewardRedemption[]

  @@map("users")
  @@schema("temuevent")
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELED

  @@schema("temuevent")
}

enum PurchaseStatus {
  WAITING_FOR_PAYMENT
  WAITING_FOR_ADMIN_CONFIRMATION
  DONE
  REJECTED
  EXPIRED
  CANCELED

  @@schema("temuevent")
}

model Event {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizerId String      @map("organizer_id") @db.Uuid
  slug        String      @unique
  name        String
  category    String
  location    String
  venue       String      @default("")
  address     String      @default("")
  description String      @default("")
  imageUrl    String?     @map("image_url")
  startAt     DateTime    @map("start_at") @db.Timestamptz(3)
  endAt       DateTime    @map("end_at") @db.Timestamptz(3)
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organizer   User        @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  ticketTypes TicketType[]
  purchases   Purchase[]

  @@index([organizerId, startAt])
  @@index([category, location, startAt])
  @@map("events")
  @@schema("temuevent")
}

model TicketType {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  name           String
  description    String   @default("")
  price          BigInt
  quota          Int
  availableSeats Int      @map("available_seats")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  purchaseItems  PurchaseItem[]

  @@unique([eventId, name])
  @@unique([eventId, id])
  @@map("ticket_types")
  @@schema("temuevent")
}

model Purchase {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reference             String         @unique
  customerId            String         @map("customer_id") @db.Uuid
  eventId               String         @map("event_id") @db.Uuid
  status                PurchaseStatus @default(WAITING_FOR_PAYMENT)
  subtotal              BigInt
  voucherDiscount       BigInt         @default(0) @map("voucher_discount")
  couponDiscount        BigInt         @default(0) @map("coupon_discount")
  pointsUsed            BigInt         @default(0) @map("points_used")
  totalPrice            BigInt         @map("total_price")
  paymentDueAt          DateTime?      @map("payment_due_at") @db.Timestamptz(3)
  proofUploadedAt       DateTime?      @map("proof_uploaded_at") @db.Timestamptz(3)
  decisionDueAt         DateTime?      @map("decision_due_at") @db.Timestamptz(3)
  paymentProofKey       String?        @map("payment_proof_key")
  completedAt           DateTime?      @map("completed_at") @db.Timestamptz(3)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  customer              User           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  event                 Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  items                 PurchaseItem[]
  rewardRedemption      RewardRedemption?

  @@unique([eventId, id])
  @@unique([customerId, id])
  @@index([customerId, createdAt])
  @@index([eventId, status])
  @@index([status, paymentDueAt])
  @@index([status, decisionDueAt])
  @@map("purchases")
  @@schema("temuevent")
}

model PurchaseItem {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String     @map("event_id") @db.Uuid
  purchaseId  String     @map("purchase_id") @db.Uuid
  ticketTypeId String    @map("ticket_type_id") @db.Uuid
  quantity    Int
  unitPrice   BigInt     @map("unit_price")
  lineTotal   BigInt     @map("line_total")
  purchase    Purchase   @relation(fields: [eventId, purchaseId], references: [eventId, id], onDelete: Restrict)
  ticketType  TicketType @relation(fields: [eventId, ticketTypeId], references: [eventId, id], onDelete: Restrict)

  @@unique([purchaseId, ticketTypeId])
  @@index([eventId, purchaseId])
  @@index([eventId, ticketTypeId])
  @@map("purchase_items")
  @@schema("temuevent")
}

model AuthSession {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens AuthRefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
  @@schema("temuevent")
}

// Store SHA-256 hashes of random refresh secrets, never their raw cookie values.
model AuthRefreshToken {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String      @map("session_id") @db.Uuid
  tokenHash  String      @unique @map("token_hash") @db.VarChar(64)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime    @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?   @map("consumed_at") @db.Timestamptz(3)
  session    AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("auth_refresh_tokens")
  @@schema("temuevent")
}

enum RewardRedemptionStatus {
  RESERVED
  CONSUMED
  RESTORED

  @@schema("temuevent")
}

// One optional incoming referral per registered account. Issuance is atomic in the service.
model Referral {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrerId     String   @map("referrer_id") @db.Uuid
  referredUserId String   @unique @map("referred_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  referrer       User     @relation("ReferralsGiven", fields: [referrerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  referredUser   User     @relation("ReferralUsed", fields: [referredUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pointGrant     PointGrant?
  rewardCoupon   RewardCoupon?

  @@unique([id, referrerId])
  @@unique([id, referredUserId])
  @@index([referrerId, createdAt])
  @@map("referrals")
  @@schema("temuevent")
}

// Each award has its own expiry. remainingAmount excludes amounts reserved by purchases.
model PointGrant {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  referralId      String   @unique @map("referral_id") @db.Uuid
  amount          BigInt
  remainingAmount BigInt   @map("remaining_amount")
  creditedAt      DateTime @default(now()) @map("credited_at") @db.Timestamptz(3)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  referral        Referral @relation(fields: [referralId, userId], references: [id, referrerId], onDelete: Restrict, onUpdate: Restrict)
  allocations     PointAllocation[]

  @@unique([userId, id])
  @@unique([referralId, userId])
  @@index([userId, expiresAt])
  @@map("point_grants")
  @@schema("temuevent")
}

// Platform referral coupon; event vouchers remain feature 1's separate entity.
model RewardCoupon {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  referralId    String   @unique @map("referral_id") @db.Uuid
  code          String   @unique @db.VarChar(32)
  discountValue BigInt   @map("discount_value")
  issuedAt      DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt     DateTime @map("expires_at") @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  referral      Referral @relation(fields: [referralId, userId], references: [id, referredUserId], onDelete: Restrict, onUpdate: Restrict)
  redemptions   RewardRedemption[]

  @@unique([userId, id])
  @@unique([referralId, userId])
  @@index([userId, expiresAt])
  @@map("reward_coupons")
  @@schema("temuevent")
}

// One reward claim per purchase. A SQL partial unique index prevents concurrent coupon claims.
model RewardRedemption {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purchaseId     String                 @unique @map("purchase_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  couponId       String?                @map("coupon_id") @db.Uuid
  pointsUsed     BigInt                 @default(0) @map("points_used")
  couponDiscount BigInt                 @default(0) @map("coupon_discount")
  status         RewardRedemptionStatus @default(RESERVED)
  reservedAt     DateTime               @default(now()) @map("reserved_at") @db.Timestamptz(3)
  consumedAt     DateTime?              @map("consumed_at") @db.Timestamptz(3)
  restoredAt     DateTime?              @map("restored_at") @db.Timestamptz(3)
  updatedAt      DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  purchase       Purchase               @relation(fields: [userId, purchaseId], references: [customerId, id], onDelete: Restrict, onUpdate: Restrict)
  coupon         RewardCoupon?          @relation(fields: [userId, couponId], references: [userId, id], onDelete: Restrict, onUpdate: Restrict)
  allocations    PointAllocation[]

  @@unique([userId, id])
  @@unique([userId, purchaseId])
  @@index([userId, reservedAt])
  @@index([userId, couponId])
  @@map("reward_redemptions")
  @@schema("temuevent")
}

// Exact earning batches used by a purchase; never infer restoration from a total balance.
model PointAllocation {
  redemptionId String   @map("redemption_id") @db.Uuid
  pointGrantId String   @map("point_grant_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  amount       BigInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  redemption   RewardRedemption @relation(fields: [userId, redemptionId], references: [userId, id], onDelete: Restrict, onUpdate: Restrict)
  pointGrant   PointGrant @relation(fields: [userId, pointGrantId], references: [userId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([redemptionId, pointGrantId])
  @@index([userId, redemptionId])
  @@index([userId, pointGrantId])
  @@map("point_allocations")
  @@schema("temuevent")
}


