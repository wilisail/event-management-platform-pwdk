{
  "name": "temuevent-shared-database",
  "version": "0.1.0",
  "private": true,
  "description": "Shared PostgreSQL/Prisma starter for feature 1 and feature 2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:check": "node scripts/run-with-ca.mjs scripts/check.ts",
    "db:status": "prisma migrate status",
    "db:deploy": "prisma migrate deploy",
    "db:verify": "node scripts/run-with-ca.mjs scripts/verify.ts",
    "db:verify:auth": "node scripts/run-with-ca.mjs scripts/verify-auth.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "tsx": "4.20.0",
    "typescript": "5.7.3"
  }
}

