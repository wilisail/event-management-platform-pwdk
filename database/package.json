{
  "name": "temuevent-shared-database",
  "version": "0.1.0",
  "private": true,
  "description": "Shared PostgreSQL/Prisma starter for feature 1 and feature 2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "qa:round5": "tsc --project qa/tsconfig.json && node --import tsx scripts/verify-round5-isolated.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:check": "node scripts/run-with-ca.mjs scripts/check.ts",
    "db:status": "prisma migrate status",
    "db:deploy": "prisma migrate deploy",
    "db:verify": "node scripts/run-with-ca.mjs scripts/verify.ts",
    "db:verify:auth": "node scripts/run-with-ca.mjs scripts/verify-auth.ts",
    "db:verify:reviews": "node scripts/run-with-ca.mjs scripts/verify-reviews.ts",
    "qa:round6": "tsc --project qa/tsconfig.json && node --import tsx scripts/verify-round6-isolated.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3",
    "prisma": "7.10.1",
    "tsx": "4.20.0",
    "typescript": "5.7.3"
  }
}
